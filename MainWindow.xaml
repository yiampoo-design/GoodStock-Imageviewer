<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="GoodStock Image Viewer" Width="1280" Height="800"
        WindowStyle="None" Background="Transparent"
        WindowStartupLocation="CenterScreen" MinWidth="900" MinHeight="600"
        x:Name="RootWindow"
        StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="28" ResizeBorderThickness="5"
                            GlassFrameThickness="-1" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#0E1117"/>
        <SolidColorBrush x:Key="BgAltBrush" Color="#161B22"/>
        <SolidColorBrush x:Key="BgCanvasBrush" Color="#0D1117"/>
        <SolidColorBrush x:Key="BgInstructBrush" Color="#111827"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#21262D"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6EDF3"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B949E"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#6E7681"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#238636"/>
        <SolidColorBrush x:Key="AccentFgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BtnBgBrush" Color="#21262D"/>
        <SolidColorBrush x:Key="BtnHoverBgBrush" Color="#30363D"/>
        <SolidColorBrush x:Key="BtnActiveBgBrush" Color="#1F6FEB"/>
        <SolidColorBrush x:Key="GutterBrush" Color="#161B22"/>
        <SolidColorBrush x:Key="MutedFgBrush" Color="#484F58"/>

        <SolidColorBrush x:Key="FolderThumbBgBrush" Color="#2A2000"/>
        <SolidColorBrush x:Key="FolderBorderBrush" Color="#C89400"/>

        <DrawingImage x:Key="FolderIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFA000">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M853 256 H469 L384 171 H171 C124 171 85 209 85 256 V427 H939 V341 C939 294 900 256 853 256Z"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFCA28">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M853 256 H171 C124 256 85 294 85 341 V768 C85 815 124 853 171 853 H853 C900 853 939 815 939 768 V341 C939 294 900 256 853 256Z"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="FolderOpenIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFA000">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M171 341 H85 V256 L171 171 H427 L491 107 H853 C900 107 939 145 939 192 V256 H491 L427 320 H171 V341Z"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFCA28">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M939 256 H171 C124 256 85 294 85 341 V768 C85 815 124 853 171 853 H853 C900 853 939 815 939 768 V256Z"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFD54F">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M85 768 V341 C85 294 124 256 171 256 H939 V768 C939 815 900 853 853 853 H171 C124 853 85 815 85 768Z"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <Style x:Key="ToolbarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnHoverBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnActiveBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnHoverBgBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnHoverBgBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource WinBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TreeBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnHoverBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThumbBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FolderBorderBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="#15FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#20FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Background" Value="#15238636"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ViewerBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BtnBgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnHoverBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewerTitleBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnHoverBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SizeSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="96"/>
            <Setter Property="Maximum" Value="256"/>
            <Setter Property="Value" Value="160"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SelBtn" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnHoverBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CrumbBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnHoverBgBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnActiveBgBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentFgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SortBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnHoverBgBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SortMenuItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30363D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrevTabBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="PreviewTabs"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnHoverBgBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="SegTabs"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnHoverBgBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentedTabBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgInstructBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleBarRow" Height="28"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="26"/>
            </Grid.RowDefinitions>

            <!-- ROW 0 — TITLEBAR -->
            <Border Grid.Row="0" Background="#161B22" MouseLeftButtonDown="Titlebar_MouseLeftButtonDown">
                <Grid Margin="12,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="4" VerticalAlignment="Center"
                            Margin="0,0,8,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3B82F6" Offset="0"/>
                                <GradientStop Color="#A855F7" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="GS" Foreground="White" FontSize="8" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="GoodStock Image Viewer" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource BtnBgBrush}" CornerRadius="999"
                                Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Stable v8.5 · Windows 11" Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="10" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch" Margin="0,0,4,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource WinBtn}" Content="&#xE949;" FontSize="10" Click="Minimize_Click"/>
                        <Button Style="{StaticResource WinBtn}" Content="&#xE739;" FontSize="10" Click="Maximize_Click"/>
                        <Button Style="{StaticResource CloseBtn}" Content="&#xE106;" FontSize="10" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ROW 1 — MENUBAR -->
            <Border Grid.Row="1" Background="{StaticResource BgBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource MenuBtn}" Content="File"/>
                        <Button Style="{StaticResource MenuBtn}" Content="Edit"/>
                        <Button Style="{StaticResource MenuBtn}" Content="View"/>
                        <Button Style="{StaticResource MenuBtn}" Content="Tools"/>
                        <Button Style="{StaticResource MenuBtn}" Content="Tag"/>
                        <Button Style="{StaticResource MenuBtn}" Content="Create"/>
                        <Button Style="{StaticResource MenuBtn}" Content="Favorites"/>
                        <Button Style="{StaticResource MenuBtn}" Content="Settings"/>
                        <Button Style="{StaticResource MenuBtn}" Content="Help"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Style="{StaticResource MenuBtn}" Content="EN ▾" FontSize="11"/>
                        <Button Style="{StaticResource ToolbarBtn}" Width="34" Height="28"
                                Click="ToggleTheme_Click">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"
                                          Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ROW 2 — TOOLBAR -->
            <Border Grid.Row="2" Background="{StaticResource BgBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Margin="4,0" VerticalAlignment="Center">
                    <!-- Open -->
                    <Button Style="{StaticResource ToolbarBtn}" ToolTip="Open (Ctrl+O)" Click="MenuOpen_Click">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M6 17l2-5h14l-3 8a2 2 0 01-2 1H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h7a2 2 0 012 2v4"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <!-- Save As -->
                    <Button Style="{StaticResource ToolbarBtn}" ToolTip="Save (Ctrl+S)" Click="MenuSave_Click">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z M17 21 17 13 7 13 7 21 M7 3 7 8 15 8"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <!-- Print -->
                    <Button Style="{StaticResource ToolbarBtn}" ToolTip="Print (Ctrl+P)">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M6 9 6 2 18 2 18 9 M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2 M6 14h12v8H6z"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <!-- Email -->
                    <Button Style="{StaticResource ToolbarBtn}" ToolTip="Email">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z M22 6 12 13 2 6"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <Border Width="1" Height="18" Background="{StaticResource BorderBrush}" Margin="6,0"/>

                    <!-- Copy -->
                    <Button Style="{StaticResource ToolbarBtn}" ToolTip="Copy (Ctrl+C)" Click="ToolbarCopy_Click">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M9 9h13a2 2 0 012 2v9a2 2 0 01-2 2H9V9z M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <!-- Move -->
                    <Button Style="{StaticResource ToolbarBtn}" ToolTip="Move" Click="ToolbarMove_Click">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M5 9 2 12 5 15 M9 5 12 2 15 5 M15 19 12 22 9 19 M19 9 22 12 19 15 M2 12h20 M12 2v20"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <!-- Delete -->
                    <Button Style="{StaticResource ToolbarBtn}" ToolTip="Delete (Del)" Click="ToolbarDelete_Click">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M3 6 5 6 21 6 M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <!-- Rename -->
                    <Button Style="{StaticResource ToolbarBtn}" ToolTip="Rename (F2)" Click="ToolbarRename_Click">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M18 2 22 6 M7.5 20.5 19 9l-4-4L3.5 16.5 2 22z"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <Border Width="1" Height="18" Background="{StaticResource BorderBrush}" Margin="6,0"/>

                    <!-- Rotate — disabled until lossless/safe implementation exists -->
                    <Button Style="{StaticResource ToolbarBtn}" ToolTip="Rotate — Coming soon" IsEnabled="False">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M21 2v6h-6 M21 13a9 9 0 11-3-7.7L21 8"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <!-- Crop -->
                    <Button Style="{StaticResource ToolbarBtn}" ToolTip="Crop (C) — Coming soon" x:Name="BtnCrop" Click="BtnCrop_Click" IsEnabled="False">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M6.13 1 6 16a2 2 0 002 2h15 M1 6.13 16 6a2 2 0 012 2v15"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <!-- Draw -->
                    <Button Style="{StaticResource ToolbarBtn}" ToolTip="Draw (B) — Coming soon" x:Name="BtnDraw" Click="BtnDraw_Click" IsEnabled="False">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M12 19l7-7 3 3-7 7-3-3z M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z M2 2l7.586 7.586"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                <Ellipse Canvas.Left="9.5" Canvas.Top="9.5" Width="5" Height="5"
                                         Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <!-- Compare -->
                    <Button Style="{StaticResource ToolbarBtn}" ToolTip="Compare">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M3 3h18a2 2 0 012 2v14a2 2 0 01-2 2H3a2 2 0 01-2-2V5a2 2 0 012-2z M12 3v18"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <Border Width="1" Height="18" Background="{StaticResource BorderBrush}" Margin="6,0"/>

                    <!-- Convert -->
                    <Button Style="{StaticResource ToolbarBtn}" ToolTip="Convert">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M17 2l4 4-4 4 M3 11v-1a4 4 0 014-4h14 M7 22l-4-4 4-4 M21 13v1a4 4 0 01-4 4H3"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <!-- Batch Convert -->
                    <Button Style="{StaticResource ToolbarBtn}" ToolTip="Batch Convert" Click="MenuBatchConvert_Click">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M17 2l4 4-4 4 M3 11v-1a4 4 0 014-4h14 M7 22l-4-4 4-4 M21 13v1a4 4 0 01-4 4H3"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <!-- Slideshow -->
                    <Button Style="{StaticResource ToolbarBtn}" ToolTip="Slideshow (F5)">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M5 3l14 9-14 9V3z"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <!-- Capture -->
                    <Button Style="{StaticResource ToolbarBtn}" ToolTip="Capture">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M14.5 4h-5L7 7H4a2 2 0 00-2 2v9a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2h-3l-2.5-3z"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                <Ellipse Canvas.Left="9" Canvas.Top="10" Width="6" Height="6"
                                         Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <Border Width="1" Height="18" Background="{StaticResource BorderBrush}" Margin="6,0"/>

                    <!-- Back -->
                    <Button Style="{StaticResource ToolbarBtn}" ToolTip="Back" Click="Back_Click">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M15 18 9 12 15 6"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <!-- Up -->
                    <Button Style="{StaticResource ToolbarBtn}" ToolTip="Up" Click="Up_Click">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M18 15 12 9 6 15"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <!-- Refresh -->
                    <Button Style="{StaticResource ToolbarBtn}" ToolTip="Refresh (F5)" Click="MenuRefresh_Click">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M21 2v6h-6 M3 12a9 9 0 0115-6.7L21 8 M3 22v-6h6 M21 12A9 9 0 016 18.7L3 16"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- Spacer -->
                    <Border Width="16"/>

                    <!-- Search box -->
                    <Border Background="{StaticResource BtnBgBrush}" CornerRadius="8"
                            Padding="10,0" Margin="0,0,6,0" Width="260" Height="30">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Viewbox Grid.Column="0" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Ellipse Canvas.Left="3" Canvas.Top="3" Width="15" Height="15"
                                             Stroke="{StaticResource TextMutedBrush}" StrokeThickness="2" Fill="Transparent"/>
                                    <Path Data="M21 21 16.65 16.65"
                                          Stroke="{StaticResource TextMutedBrush}" StrokeThickness="2"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                            <TextBox Grid.Column="1" x:Name="SearchBox" Background="Transparent"
                                     Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0"
                                     FontSize="12" VerticalContentAlignment="Center"
                                     CaretBrush="{StaticResource TextPrimaryBrush}"
                                     TextChanged="SearchBox_TextChanged"/>
                        </Grid>
                    </Border>

                    <!-- Preview toggle -->
                    <ToggleButton x:Name="PreviewToggle" Style="{StaticResource SelBtn}"
                                  ToolTip="Preview Pane" IsChecked="True" Click="PreviewToggle_Click">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Path Data="M3 3h18a2 2 0 012 2v14a2 2 0 01-2 2H3a2 2 0 01-2-2V5a2 2 0 012-2z M9 3v18"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                    </ToggleButton>
                    <!-- Settings -->
                    <Button Style="{StaticResource ToolbarBtn}" ToolTip="Settings" Click="MenuSettings_Click">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="M12.22 2h-.44a2 2 0 00-2 2v.18a2 2 0 01-1 1.73l-.43.25a2 2 0 01-2 0l-.15-.08a2 2 0 00-2.73.73l-.22.38a2 2 0 00.73 2.73l.15.1a2 2 0 011 1.72v.51a2 2 0 01-1 1.74l-.15.09a2 2 0 00-.73 2.73l.22.38a2 2 0 002.73.73l.15-.08a2 2 0 012 0l.43.25a2 2 0 011 1.73V20a2 2 0 002 2h.44a2 2 0 002-2v-.18a2 2 0 011-1.73l.43-.25a2 2 0 012 0l.15.08a2 2 0 002.73-.73l.22-.39a2 2 0 00-.73-2.73l-.15-.08a2 2 0 01-1-1.74v-.5a2 2 0 011-1.74l.15-.09a2 2 0 00.73-2.73l-.22-.38a2 2 0 00-2.73-.73l-.15.08a2 2 0 01-2 0l-.43-.25a2 2 0 01-1-1.73V4a2 2 0 00-2-2z"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                <Ellipse Canvas.Left="9" Canvas.Top="9" Width="6" Height="6"
                                         Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ROW 3 — WORKBENCH -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FoldersCol" Width="224" MinWidth="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition x:Name="PreviewCol" Width="320" MinWidth="240"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Folder tree -->
                <Border Grid.Column="0" Background="{StaticResource GutterBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Padding="12,8" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Folders" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- TreeView -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="4,4">
                            <TreeView x:Name="FolderTree" Background="Transparent" BorderThickness="0"
                                      Foreground="#E6EDF3" FontSize="12"
                                      SelectedItemChanged="FolderTree_SelectedItemChanged"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Splitter 1 -->
                <GridSplitter Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Stretch" Cursor="SizeWE"/>

                <!-- CENTER: Breadcrumbs + Thumbnail grid -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="14,8" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel x:Name="Breadcrumbs" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Sort:" Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button x:Name="SortBtn" Style="{StaticResource SortBtn}" Click="SortBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="SortLabel" Text="name" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"/>
                                        <TextBlock Text=" ▾" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                                <Popup x:Name="SortPopup" PlacementTarget="{Binding ElementName=SortBtn}"
                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                       PopupAnimation="Fade">
                                    <Border Background="#1C2128" BorderBrush="#30363D" BorderThickness="1"
                                            CornerRadius="6" Padding="4" Margin="8">
                                        <StackPanel>
                                            <Button x:Name="SortByName" Content="Name" Click="SortOption_Click"
                                                    Tag="name" Style="{StaticResource SortMenuItem}"/>
                                            <Button x:Name="SortByDate" Content="Date Modified" Click="SortOption_Click"
                                                    Tag="date" Style="{StaticResource SortMenuItem}"/>
                                            <Button x:Name="SortBySize" Content="File Size" Click="SortOption_Click"
                                                    Tag="size" Style="{StaticResource SortMenuItem}"/>
                                            <Button x:Name="SortByType" Content="File Type" Click="SortOption_Click"
                                                    Tag="type" Style="{StaticResource SortMenuItem}"/>
                                            <Separator Background="#30363D" Margin="4,2"/>
                                            <Button x:Name="SortDirectionBtn" Click="SortDirection_Click"
                                                    Style="{StaticResource SortMenuItem}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="SortDirectionLabel" Text="↑ Ascending" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                                <TextBlock Text="thumb" Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                           VerticalAlignment="Center" Margin="12,0,6,0"/>
                                <Slider x:Name="ThumbSizeSlider" Style="{StaticResource SizeSlider}" Value="160"
                                        ValueChanged="ThumbSizeSlider_ValueChanged"/>
                                <Button Style="{StaticResource ToolbarBtn}" Content="☑" ToolTip="Select All"
                                        Click="SelectAll_Click"/>
                                <Button Style="{StaticResource ToolbarBtn}" Content="⬚" ToolTip="Deselect All"
                                        Click="DeselectAll_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Padding="14,14">
                            <ItemsControl x:Name="ThumbsGrid">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemWidth="160" ItemHeight="194"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ThumbBtn}" Margin="0,0,0,12"
                                            Click="Thumb_Click" MouseDoubleClick="Thumb_DoubleClick" Tag="{Binding}">
                                        <Button.ContextMenu>
                                            <ContextMenu Opened="ThumbContextMenu_Opened">
                                                <MenuItem Header="Open" Click="CtxOpen_Click" Tag="{Binding}">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="&#xE8E7;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="Copy" Click="CtxCopy_Click" Tag="{Binding}">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Cut" Click="CtxCut_Click" Tag="{Binding}">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="&#xE8C6;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Paste" Click="CtxPaste_Click">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="Delete" Click="CtxDelete_Click" Tag="{Binding}">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Rename" Click="CtxRename_Click" Tag="{Binding}">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="Properties" Click="CtxProperties_Click" Tag="{Binding}">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <StackPanel HorizontalAlignment="Stretch">
                                            <Border CornerRadius="6,6,0,0"
                                                    Height="108"
                                                    BorderThickness="0"
                                                    SizeChanged="ThumbImageBorder_SizeChanged">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource BgAltBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource FolderThumbBgBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource FolderBorderBrush}"/>
                                                                <Setter Property="BorderThickness" Value="2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsFolder}" Value="True"/>
                                                                            <Condition Binding="{Binding Thumbnail}" Value="{x:Null}"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                    <Image Source="{StaticResource FolderIcon}"
                                                               Width="48" Height="48"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsFolder}" Value="True"/>
                                                                            <Condition Binding="{Binding Thumbnail}" Value="{x:Null}"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                    <Image Source="{StaticResource FolderIcon}"
                                                           HorizontalAlignment="Stretch"
                                                           VerticalAlignment="Stretch"
                                                           Stretch="Fill"
                                                           Opacity="0.35"
                                                           RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsFolder}" Value="True"/>
                                                                            <Condition Binding="{Binding Thumbnail}" Value="{x:Null}"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </MultiDataTrigger>
                                                                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                            Margin="0,0,8,8" Background="#CC111827"
                                                            CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding FileType}" Foreground="White"
                                                                   FontSize="9" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Margin="8,8,0,0" Background="#80111827"
                                                    CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding Index}" Foreground="White" FontSize="10"/>
                                            </Border>
                                            <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="12" Margin="10,8,10,2" TextTrimming="CharacterEllipsis"
                                                       FontWeight="Medium"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="10,0,10,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="{Binding Megapixels}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding Dimensions}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding FileSize}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    </Grid>
                </Grid>

                <!-- Splitter 2 -->
                <GridSplitter Grid.Column="3" Width="1" Background="{StaticResource BorderBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Stretch" Cursor="SizeWE"/>

                <!-- RIGHT: Preview pane -->
                <Border x:Name="PreviewPane" Grid.Column="4" Background="{StaticResource BgBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"
                        Visibility="Visible" MinWidth="240">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="220"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Image preview (fixed height) -->
                        <Border Grid.Row="0" Background="#FAFBFC" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid Margin="8">
                                <Image x:Name="PreviewImage" Stretch="Uniform" Margin="8"/>
                                <TextBlock x:Name="PreviewPlaceholder" Text="Select an image to preview"
                                           Foreground="#999" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Segmented tab bar -->
                        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1" Padding="12,6">
                            <Border Background="{StaticResource BtnBgBrush}" CornerRadius="6" Padding="2"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="TabExif" Content="EXIF Info" IsChecked="True"
                                                 Click="PreviewTab_Click" GroupName="PreviewTab"
                                                 Style="{StaticResource SegmentedTabBtn}"/>
                                    <RadioButton x:Name="TabMeta" Content="Metadata"
                                                 Click="PreviewTab_Click" GroupName="PreviewTab"
                                                 Style="{StaticResource SegmentedTabBtn}"/>
                                    <RadioButton x:Name="TabPreflight" Content="Preflight"
                                                 Click="PreviewTab_Click" GroupName="PreviewTab"
                                                 Style="{StaticResource SegmentedTabBtn}"/>
                                    <RadioButton x:Name="TabHistogram" Content="Histogram"
                                                 Click="PreviewTab_Click" GroupName="PreviewTab"
                                                 Style="{StaticResource SegmentedTabBtn}"/>
                                </StackPanel>
                            </Border>
                        </Border>

                        <!-- Info content (scrollable, fills remaining space) -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="12,8">
                            <StackPanel>
                                <!-- File name + dimensions (always visible) -->
                                <TextBlock x:Name="InfoFileName" Text=""
                                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                <TextBlock x:Name="InfoDimensions" Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11.5" Margin="0,0,0,10"/>

                                <!-- EXIF Panel -->
                                <StackPanel x:Name="ExifPanel">
                                    <TextBlock x:Name="ExifNoData" Text="No EXIF data available for this format"
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                               FontStyle="Italic" Margin="0,0,0,8" Visibility="Collapsed"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.44*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Camera" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="ExifCamera" Text="—"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,6"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.44*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Focal Length" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="ExifFocalLength" Text="—"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,6"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.44*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="F-Stop" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="ExifFStop" Text="—"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,6"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.44*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Shutter Speed" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="ExifShutterSpeed" Text="—"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,6"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.44*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="ISO Speed" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="ExifISO" Text="—"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,6"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.44*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Lens" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="ExifLens" Text="—"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,6"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.44*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Date Taken" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="ExifDateTaken" Text="—"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Histogram Panel (RGB) -->
                                <StackPanel x:Name="HistogramPanel" Visibility="Collapsed">
                                    <TextBlock Text="Histogram" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11" Margin="0,0,0,8"/>

                                    <!-- Red channel -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="R" Foreground="#EF4444" FontSize="10" Width="14"
                                                   FontWeight="Bold" VerticalAlignment="Center"/>
                                        <StackPanel x:Name="HistRedBars" Orientation="Horizontal"/>
                                    </StackPanel>

                                    <!-- Green channel -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="G" Foreground="#22C55E" FontSize="10" Width="14"
                                                   FontWeight="Bold" VerticalAlignment="Center"/>
                                        <StackPanel x:Name="HistGreenBars" Orientation="Horizontal"/>
                                    </StackPanel>

                                    <!-- Blue channel -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="B" Foreground="#3B82F6" FontSize="10" Width="14"
                                                   FontWeight="Bold" VerticalAlignment="Center"/>
                                        <StackPanel x:Name="HistBlueBars" Orientation="Horizontal"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Metadata Panel -->
                                <StackPanel x:Name="MetaPanel" Visibility="Collapsed">
                                    <TextBlock Text="File Properties" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.44*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="File Name" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="MetaFileName" Text="—"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,6"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.44*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="File Type" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="MetaFileType" Text="—"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,6"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.44*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Dimensions" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="MetaDimensions" Text="—"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,6"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.44*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="File Size" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="MetaFileSize" Text="—"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,6"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.44*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Modified" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="MetaModified" Text="—"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,6"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.44*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Folder" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="MetaFolder" Text="—"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8,0,8"/>

                                    <TextBlock Text="EXIF Metadata" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.44*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Camera" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="MetaCamera" Text="—"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,6"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.44*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Lens" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="MetaLens" Text="—"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,6"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.44*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Date Taken" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="MetaDateTaken" Text="—"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,6"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.44*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Description" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="MetaDescription" Text="—"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,6"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.44*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Artist" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="MetaArtist" Text="—"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,6"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.44*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Copyright" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" x:Name="MetaCopyright" Text="—"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Button Content="Manage Metadata..." Click="ManageMetadata_Click" Cursor="Hand"
                                            HorizontalAlignment="Left" Margin="0,10,0,0"
                                            Background="{StaticResource BtnBgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                            BorderThickness="0" Padding="12,6" FontSize="11">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnHoverBgBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Preflight Panel (scrollable) -->
                        <ScrollViewer x:Name="PreflightPanel" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                      Padding="12,8" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="STOCK PREFLIGHT" Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                <Border Background="{StaticResource BgInstructBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Dimensions" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="PreflightDimensions" Text="—" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource BgInstructBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Format" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="PreflightFormat" Text="—" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource BgInstructBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="ICC Profile" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="PreflightIcc" Text="—" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource BgInstructBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Metadata Completeness" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="PreflightMetadata" Text="—" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource BgInstructBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="GPS Privacy" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="PreflightGps" Text="—" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource BgInstructBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Keywords" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="PreflightKeywords" Text="—" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Button Content="Run Preflight Check" Click="RunPreflight_Click" Cursor="Hand"
                                        HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Background="{StaticResource AccentBrush}" Foreground="White"
                                        BorderThickness="0" Padding="14,8" FontSize="12" FontWeight="SemiBold">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ROW 4 — STATUSBAR -->
            <Border Grid.Row="4" Background="{StaticResource BgBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="ExifToolBadge" CornerRadius="999" Padding="8,2" Margin="0,0,10,0"
                                Background="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ExifToolStatusText" Text="ExifTool"
                                           Foreground="White" FontSize="10" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="StatusFiles" Text="237 files"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,12,0"/>
                        <TextBlock x:Name="StatusSelection" Text="12 selected"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,12,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusSize" Text="3.2 MB"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,12,0"/>
                        <TextBlock x:Name="StatusPath" Text=""
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" MaxWidth="400"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- VIEWER OVERLAY -->
            <Border x:Name="ViewerOverlay" Grid.Row="0" Grid.RowSpan="5"
                    Background="#F20E1117" Visibility="Collapsed" Panel.ZIndex="100">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Viewer TITLEBAR -->
                    <Border Grid.Row="0" Background="#161B22"
                            MouseLeftButtonDown="ViewerTitlebar_MouseLeftButtonDown"
                            MouseMove="ViewerTitlebar_MouseMove"
                            MouseLeftButtonUp="ViewerTitlebar_MouseLeftButtonUp">
                        <Grid Margin="12,0" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: icon + filename (DRAGGABLE) -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        Cursor="Hand">
                                <Border Width="18" Height="18" CornerRadius="3" VerticalAlignment="Center"
                                        Margin="0,0,8,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3B82F6" Offset="0"/>
                                            <GradientStop Color="#A855F7" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="GS" Foreground="White" FontSize="7" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="ViewerTitle" Text="Image Viewer"
                                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Center: prev + counter + next -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                <Button Style="{StaticResource ViewerTitleBtn}" ToolTip="Previous (←)"
                                        Click="ViewerPrev_Click" Width="32" Height="28">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M15 18 9 12 15 6"
                                                  Stroke="White" StrokeThickness="2"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Border Background="#33FFFFFF" CornerRadius="4" Padding="10,2" Margin="6,0">
                                    <TextBlock x:Name="ViewerCounter" Text="#1 of 1"
                                               Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                                </Border>
                                <Button Style="{StaticResource ViewerTitleBtn}" ToolTip="Next (→)"
                                        Click="ViewerNext_Click" Width="32" Height="28">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M9 18 15 12 9 6"
                                                  Stroke="White" StrokeThickness="2"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </StackPanel>

                            <!-- Right: zoom + fit + rotate + close -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                <Button Style="{StaticResource ViewerTitleBtn}" ToolTip="Zoom Out (-)"
                                        Click="ViewerZoomOut_Click" Width="32" Height="28">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="24" Height="24">
                                            <Ellipse Canvas.Left="3" Canvas.Top="3" Width="16" Height="16"
                                                     Stroke="White" StrokeThickness="1.7" Fill="Transparent"/>
                                            <Path Data="M21 21 16.65 16.65 M8 11h6"
                                                  Stroke="White" StrokeThickness="1.7"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <TextBlock x:Name="ViewerZoom" Text="100%" Foreground="White" FontSize="11"
                                           VerticalAlignment="Center" Margin="2,0"
                                           WindowChrome.IsHitTestVisibleInChrome="True"/>
                                <Button Style="{StaticResource ViewerTitleBtn}" ToolTip="Zoom In (+)"
                                        Click="ViewerZoomIn_Click" Width="32" Height="28">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="24" Height="24">
                                            <Ellipse Canvas.Left="3" Canvas.Top="3" Width="16" Height="16"
                                                     Stroke="White" StrokeThickness="1.7" Fill="Transparent"/>
                                            <Path Data="M21 21 16.65 16.65 M11 8v6 M8 11h6"
                                                  Stroke="White" StrokeThickness="1.7"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Button Style="{StaticResource ViewerTitleBtn}" ToolTip="Fit to Window (0)"
                                        Click="ViewerFit_Click" Width="32" Height="28">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M8 3H5A2 2 0 003 5v3m18 0V5a2 2 0 00-2-2h-3m0 18h3a2 2 0 002-2v-3M3 16v3a2 2 0 002 2h3"
                                                  Stroke="White" StrokeThickness="1.7"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Button Style="{StaticResource ViewerTitleBtn}" ToolTip="Rotate Right (R)"
                                        Click="ViewerRotate_Click" Width="32" Height="28">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M21 2v6h-6 M21 13a9 9 0 11-3-7.7L21 8"
                                                  Stroke="White" StrokeThickness="1.7"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                                <Button x:Name="BtnClippingWarning" Style="{StaticResource ViewerTitleBtn}" ToolTip="Clipping Warning (J)"
                                        Click="ClippingWarning_Click" Width="32" Height="28">
                                    <Viewbox Width="14" Height="14">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M12 9v4M12 17h.01 M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"
                                                  Stroke="White" StrokeThickness="1.7"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                        </Canvas>
                                    </Viewbox>
                                </Button>

                                <Border Width="1" Height="16" Background="#33FFFFFF" Margin="4,0"/>

                                <!-- MINIMIZE -->
                                <Button Style="{StaticResource ViewerTitleBtn}" Content="&#xE949;" FontSize="10"
                                        FontFamily="Segoe MDL2 Assets"
                                        Click="ViewerMinimize_Click" Width="32" Height="28"
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        ToolTip="Minimize"/>
                                <!-- MAXIMIZE -->
                                <Button x:Name="ViewerMaxBtn" Style="{StaticResource ViewerTitleBtn}" Content="&#xE739;" FontSize="10"
                                        FontFamily="Segoe MDL2 Assets"
                                        Click="ViewerMaximize_Click" Width="32" Height="28"
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        ToolTip="Maximize"/>

                                <Border Width="1" Height="16" Background="#33FFFFFF" Margin="4,0"/>

                                <!-- CLOSE BUTTON -->
                                <Button Style="{StaticResource CloseBtn}" Content="&#xE106;" FontSize="12"
                                        Click="CloseViewer_Click" Width="46" Height="28"
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        ToolTip="Close Viewer (Esc)"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Viewer center: image -->
                    <Grid x:Name="ViewerImageBorder" Grid.Row="1"
                          ClipToBounds="True"
                          MouseLeftButtonDown="ViewerImageBorder_MouseLeftButtonDown"
                          MouseMove="ViewerImageBorder_MouseMove"
                          MouseLeftButtonUp="ViewerImageBorder_MouseLeftButtonUp"
                          MouseWheel="ViewerImageBorder_MouseWheel"
                          MouseDown="ViewerImageBorder_MouseDown"
                          MouseUp="ViewerImageBorder_MouseUp">
                        <Image x:Name="ViewerImage" Stretch="Uniform"
                               RenderTransformOrigin="0.5,0.5"/>
                        <Image x:Name="ClippingOverlay" Stretch="Uniform" IsHitTestVisible="False" Opacity="0.7"/>
                    </Grid>

                    <!-- Viewer STATUSBAR -->
                    <Border Grid.Row="2" Background="#161B22" BorderBrush="#30FFFFFF" BorderThickness="0,1,0,0">
                        <Grid Margin="12,0" Height="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ViewerStatusDims" Grid.Column="0"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="ViewerStatusZoom" Grid.Column="1"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ViewerStatusSize" Grid.Column="2"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- CROP OVERLAY -->
            <Border x:Name="CropOverlay" Grid.Row="0" Grid.RowSpan="5"
                    Background="#F20E1117" Visibility="Collapsed" Panel.ZIndex="90">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Crop top toolbar -->
                    <Border Grid.Row="0" Grid.ColumnSpan="2" Height="48" Background="{StaticResource BgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Apply -->
                            <Button Style="{StaticResource ToolbarBtn}" ToolTip="Apply Crop"
                                    Foreground="{StaticResource AccentBrush}" Click="ApplyCrop_Click">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M20 6 9 17 4 12"
                                              Stroke="{StaticResource AccentBrush}" StrokeThickness="1.7"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <!-- Cancel -->
                            <Button Style="{StaticResource ToolbarBtn}" ToolTip="Cancel Crop"
                                    Click="CancelCrop_Click">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M18 6 6 18 M6 6 18 18"
                                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Border Width="1" Height="18" Background="{StaticResource BorderBrush}" Margin="8,0"/>
                            <!-- Original -->
                            <Button Style="{StaticResource ToolbarBtn}" ToolTip="Original">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M8 3H5A2 2 0 003 5v3m18 0V5a2 2 0 00-2-2h-3m0 18h3a2 2 0 002-2v-3M3 16v3a2 2 0 002 2h3"
                                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource ToolbarBtn}" Content="1:1" ToolTip="1:1"/>
                            <Button Style="{StaticResource ToolbarBtn}" Content="4:3" ToolTip="4:3"/>
                            <Button Style="{StaticResource ToolbarBtn}" Content="16:9" ToolTip="16:9"/>
                            <Button Style="{StaticResource ToolbarBtn}" Content="Square" ToolTip="Square"/>
                            <Border Width="1" Height="18" Background="{StaticResource BorderBrush}" Margin="8,0"/>
                            <!-- Rotate -->
                            <Button Style="{StaticResource ToolbarBtn}" ToolTip="Rotate">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M21 2v6h-6 M21 13a9 9 0 11-3-7.7L21 8"
                                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <!-- Flip H -->
                            <Button Style="{StaticResource ToolbarBtn}" ToolTip="Flip H">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M12 3v18 M8 3 4 7l4 4 M16 3l4 4-4 4 M8 13l-4 4 4 4 M16 13l4 4-4 4"
                                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <!-- Flip V -->
                            <Button Style="{StaticResource ToolbarBtn}" ToolTip="Flip V">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M3 12h18 M3 8 7 4l4 4 M13 8l4-4 4 4 M3 16 7 20l4-4 M13 16l4 4 4-4"
                                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Crop main area -->
                    <Border Grid.Row="1" Grid.Column="0" Background="Transparent">
                        <Grid>
                            <Image x:Name="CropImage" Stretch="Uniform"/>
                            <Border x:Name="CropHandleTL" Width="10" Height="10" Background="White"
                                    CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="100,60,0,0" Cursor="SizeNWSE"/>
                            <Border x:Name="CropHandleTR" Width="10" Height="10" Background="White"
                                    CornerRadius="2" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,60,100,0" Cursor="SizeNESW"/>
                            <Border x:Name="CropHandleBL" Width="10" Height="10" Background="White"
                                    CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                    Margin="100,0,0,80" Cursor="SizeNESW"/>
                            <Border x:Name="CropHandleBR" Width="10" Height="10" Background="White"
                                    CornerRadius="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,100,80" Cursor="SizeNWSE"/>
                            <Border x:Name="CropRegion" BorderBrush="White" BorderThickness="2"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Width="300" Height="200" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <!-- Crop right preview -->
                    <Border Grid.Row="1" Grid.Column="1" Width="200" Background="{StaticResource BgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Crop Preview" Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11" FontWeight="SemiBold" Margin="12,12,12,8"/>

                            <Border Grid.Row="1" Margin="12" Background="{StaticResource BgInstructBrush}" CornerRadius="8">
                                <Image x:Name="CropPreviewImage" Stretch="Uniform" Margin="8"/>
                            </Border>

                            <StackPanel Grid.Row="2" Margin="12,0">
                                <TextBlock Text="Position &amp; Size" Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="X:" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11" Width="20"/>
                                    <TextBlock Grid.Column="1" Text="480 px" Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Y:" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11" Width="20"/>
                                    <TextBlock Grid.Column="1" Text="360 px" Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="W:" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11" Width="20"/>
                                    <TextBlock Grid.Column="1" Text="3072 px" Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="11"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="H:" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11" Width="20"/>
                                    <TextBlock Grid.Column="1" Text="2304 px" Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="11"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Margin="12,12,12,12">
                                <TextBlock Text="Aspect Ratio" Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ToolbarBtn}" Content="Free" FontSize="10"
                                            ToolTip="Free"/>
                                    <Button Style="{StaticResource ToolbarBtn}" Content="1:1" FontSize="10"
                                            ToolTip="1:1"/>
                                    <Button Style="{StaticResource ToolbarBtn}" Content="4:3" FontSize="10"
                                            ToolTip="4:3"/>
                                    <Button Style="{StaticResource ToolbarBtn}" Content="16:9" FontSize="10"
                                            ToolTip="16:9"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- DRAW OVERLAY -->
            <Border x:Name="DrawOverlay" Grid.Row="0" Grid.RowSpan="5"
                    Background="#F20E1117" Visibility="Collapsed" Panel.ZIndex="90">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Draw top toolbar -->
                    <Border Grid.Row="0" Grid.ColumnSpan="3" Height="48" Background="{StaticResource BgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Apply -->
                            <Button Style="{StaticResource ToolbarBtn}" ToolTip="Apply Drawing"
                                    Foreground="{StaticResource AccentBrush}" Click="ApplyDraw_Click">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M20 6 9 17 4 12"
                                              Stroke="{StaticResource AccentBrush}" StrokeThickness="1.7"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <!-- Cancel -->
                            <Button Style="{StaticResource ToolbarBtn}" ToolTip="Cancel Drawing"
                                    Click="CancelDraw_Click">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M18 6 6 18 M6 6 18 18"
                                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Border Width="1" Height="18" Background="{StaticResource BorderBrush}" Margin="8,0"/>
                            <!-- Undo -->
                            <Button Style="{StaticResource ToolbarBtn}" ToolTip="Undo (Ctrl+Z)">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M3 7v6h6 M21 17a9 9 0 00-9-9 9 9 0 00-6 2.3L3 13"
                                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <!-- Redo -->
                            <Button Style="{StaticResource ToolbarBtn}" ToolTip="Redo (Ctrl+Y)">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M21 7v6h-6 M3 17a9 9 0 019-9 9 9 0 016 2.3l3 2.7"
                                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Border Width="1" Height="18" Background="{StaticResource BorderBrush}" Margin="8,0"/>
                            <!-- Save -->
                            <Button Style="{StaticResource ToolbarBtn}" ToolTip="Save">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z M17 21 17 13 7 13 7 21 M7 3 7 8 15 8"
                                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <!-- Copy -->
                            <Button Style="{StaticResource ToolbarBtn}" ToolTip="Copy">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M9 9h13a2 2 0 012 2v9a2 2 0 01-2 2H9V9z M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"
                                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <!-- Clear -->
                            <Button Style="{StaticResource ToolbarBtn}" ToolTip="Clear">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M3 6 5 6 21 6 M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"
                                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Draw left toolbar -->
                    <Border Grid.Row="1" Grid.Column="0" Width="56" Background="{StaticResource BgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- Brush -->
                            <Button Style="{StaticResource ToolbarBtn}" ToolTip="Brush" Width="40" Height="40">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M12 19l7-7 3 3-7 7-3-3z M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z M2 2l7.586 7.586"
                                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <!-- Rectangle -->
                            <Button Style="{StaticResource ToolbarBtn}" ToolTip="Rectangle" Width="40" Height="40">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M3 3h18a2 2 0 012 2v14a2 2 0 01-2 2H3a2 2 0 01-2-2V5a2 2 0 012-2z"
                                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <!-- Circle -->
                            <Button Style="{StaticResource ToolbarBtn}" ToolTip="Circle" Width="40" Height="40">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Ellipse Canvas.Left="3" Canvas.Top="3" Width="18" Height="18"
                                                 Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7" Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <!-- Line -->
                            <Button Style="{StaticResource ToolbarBtn}" ToolTip="Line" Width="40" Height="40">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M5 19 19 5"
                                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <!-- Text -->
                            <Button Style="{StaticResource ToolbarBtn}" ToolTip="Text" Width="40" Height="40">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M6 4h12 M12 4v16 M8 20h8"
                                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="8,4"/>
                            <!-- Select -->
                            <Button Style="{StaticResource ToolbarBtn}" ToolTip="Select" Width="40" Height="40">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M3 3l7.07 16.97 2.51-7.39 7.39-2.51L3 3z M13 13l6 6"
                                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <!-- Zoom -->
                            <Button Style="{StaticResource ToolbarBtn}" ToolTip="Zoom" Width="40" Height="40">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Ellipse Canvas.Left="3" Canvas.Top="3" Width="15" Height="15"
                                                 Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7" Fill="Transparent"/>
                                        <Path Data="M21 21 16.65 16.65"
                                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                        <Path Data="M11 8v6 M8 11h6"
                                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <!-- Pan -->
                            <Button Style="{StaticResource ToolbarBtn}" ToolTip="Pan" Width="40" Height="40">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M18 11V6a2 2 0 00-4 0v5 M14 10V4a2 2 0 00-4 0v6 M10 9.5V6a2 2 0 00-4 0v8l-1.46-1.46a2 2 0 00-2.83 2.83L6 20a8 8 0 0016 0v-5a2 2 0 00-4 0"
                                              Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.7"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Draw canvas -->
                    <Border Grid.Row="1" Grid.Column="1" Background="Transparent">
                        <Grid>
                            <Image x:Name="DrawImage" Stretch="Uniform"/>
                            <Canvas x:Name="DrawCanvas" Background="Transparent"/>
                        </Grid>
                    </Border>

                    <!-- Draw right properties -->
                    <Border Grid.Row="1" Grid.Column="2" Width="200" Background="{StaticResource BgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="12">
                                <TextBlock Text="Tool Properties" Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>

                                <TextBlock Text="Brush Size" Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11" Margin="0,0,0,4"/>
                                <Slider Minimum="1" Maximum="50" Value="5" Margin="0,0,0,12"/>

                                <TextBlock Text="Opacity" Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11" Margin="0,0,0,4"/>
                                <Slider Minimum="0" Maximum="100" Value="100" Margin="0,0,0,12"/>

                                <TextBlock Text="Color" Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Width="24" Height="24" CornerRadius="4" Background="#E11D48"
                                            Margin="0,0,4,0"/>
                                    <Border Width="24" Height="24" CornerRadius="4" Background="#F97316"
                                            Margin="0,0,4,0"/>
                                    <Border Width="24" Height="24" CornerRadius="4" Background="#EAB308"
                                            Margin="0,0,4,0"/>
                                    <Border Width="24" Height="24" CornerRadius="4" Background="#22C55E"
                                            Margin="0,0,4,0"/>
                                    <Border Width="24" Height="24" CornerRadius="4" Background="#3B82F6"
                                            Margin="0,0,4,0"/>
                                    <Border Width="24" Height="24" CornerRadius="4" Background="#A855F7"/>
                                </StackPanel>

                                <TextBlock Text="Custom:" Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11" Margin="0,0,0,4"/>
                                <Border Height="32" CornerRadius="6" Background="{StaticResource BtnBgBrush}"
                                        Margin="0,0,0,12"/>

                                <TextBlock Text="Layer" Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Border Background="{StaticResource BgInstructBrush}" CornerRadius="6" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="Background" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="11"/>
                                        <TextBlock Text="Locked" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="10"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- Keyboard shortcuts handled in OnKeyDown -->
        </Grid>
    </Border>
</Window>
